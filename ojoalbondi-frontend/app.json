{
  "expo": {
    "name": "OjoAlBondi",
    "slug": "ojoalbondi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ojoalbondi",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#173A67", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }],
      ["expo-location", { "locationWhenInUsePermission": "Ojo al Bondi usa tu ubicación solo para completar el lugar del reporte." }],
      ["expo-image-picker", {
        "photosPermission": "Para adjuntar una foto opcional al reporte.",
        "cameraPermission": "Para sacar una foto opcional del reporte."
      }],
      ["react-native-maps", { "androidGoogleMapsApiKey": "TU_API_KEY_DE_GOOGLE_MAPS" }]
    ]
  }
}
